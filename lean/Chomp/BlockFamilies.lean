/-! ## The small positions -/

/-- `F7.legal` as a boolean. -/
def legalB (X : F7) : Nat → Nat → Bool
  | 0, t => decide (1 ≤ t ∧ t < X.a)
  | 1, t => decide (t < X.b)
  | 2, t => decide (t < X.c)
  | 3, t => decide (t < X.d)
  | 4, t => decide (t < X.e)
  | 5, t => decide (t < X.f)
  | 6, t => decide (t < X.k)
  | _, _ => false

theorem legalB_sound {X : F7} {i t : Nat} (h : legalB X i t = true) : X.legal i t := by
  match i, h with
  | 0, h => exact of_decide_eq_true (p := 1 ≤ t ∧ t < X.a) h
  | 1, h => exact of_decide_eq_true (p := t < X.b) h
  | 2, h => exact of_decide_eq_true (p := t < X.c) h
  | 3, h => exact of_decide_eq_true (p := t < X.d) h
  | 4, h => exact of_decide_eq_true (p := t < X.e) h
  | 5, h => exact of_decide_eq_true (p := t < X.f) h
  | 6, h => exact of_decide_eq_true (p := t < X.k) h
  | _ + 7, h => exact absurd h (by simp [legalB])

/-- The entry `(i, t, j, s)`: the bite `(i, t)` of `X` leaves a position of `W`, or one with the
legal bite `(j, s)` into `S`. -/
def okEntry (X : F7) (w : Nat × Nat × Nat × Nat) : Bool :=
  decide (isW (X.cut w.1 w.2.1)) ||
    (legalB (X.cut w.1 w.2.1) w.2.2.1 w.2.2.2 && decide (inS ((X.cut w.1 w.2.1).cut w.2.2.1 w.2.2.2)))

/-- Every height `lo ≤ t < h` of the column `i` has an entry in the table. -/
def covers (X : F7) (ws : List (Nat × Nat × Nat × Nat)) (i h lo : Nat) : Bool :=
  (List.range h).all fun t => decide (t < lo) || ws.any fun w => w.1 == i && w.2.1 == t && okEntry X w

def checkRow (X : F7) (ws : List (Nat × Nat × Nat × Nat)) : Bool :=
  covers X ws 0 X.a 1 && covers X ws 1 X.b 0 && covers X ws 2 X.c 0 && covers X ws 3 X.d 0 &&
  covers X ws 4 X.e 0 && covers X ws 5 X.f 0 && covers X ws 6 X.k 0

theorem covers_sound {X : F7} {ws : List (Nat × Nat × Nat × Nat)} {i h lo : Nat}
    (hc : covers X ws i h lo = true) {t : Nat} (ht : t < h) (hlo : lo ≤ t) :
    isW (X.cut i t) ∨ Reply inS (X.cut i t) := by
  have h1 := List.all_eq_true.mp hc t (List.mem_range.mpr ht)
  have h2 : (ws.any fun w => w.1 == i && w.2.1 == t && okEntry X w) = true := by
    rcases Bool.or_eq_true _ _ |>.mp h1 with h | h
    · exact absurd (of_decide_eq_true h) (by omega)
    · exact h
  obtain ⟨w, _, hw⟩ := List.any_eq_true.mp h2
  have hw' := Bool.and_eq_true _ _ |>.mp hw
  have hw'' := Bool.and_eq_true _ _ |>.mp hw'.1
  have e1 : w.1 = i := by simpa using hw''.1
  have e2 : w.2.1 = t := by simpa using hw''.2
  have hok := hw'.2
  unfold okEntry at hok
  rw [e1, e2] at hok
  rcases Bool.or_eq_true _ _ |>.mp hok with h | h
  · exact Or.inl (of_decide_eq_true h)
  · have h3 := Bool.and_eq_true _ _ |>.mp h
    exact Or.inr ⟨_, _, legalB_sound h3.1, of_decide_eq_true h3.2⟩

theorem checkRow_sound {X : F7} {ws : List (Nat × Nat × Nat × Nat)} (hc : checkRow X ws = true)
    {i t : Nat} (hl : X.legal i t) : isW (X.cut i t) ∨ Reply inS (X.cut i t) := by
  simp only [checkRow, Bool.and_eq_true] at hc
  obtain ⟨⟨⟨⟨⟨⟨c0, c1⟩, c2⟩, c3⟩, c4⟩, c5⟩, c6⟩ := hc
  match i, hl with
  | 0, hl => exact covers_sound c0 hl.2 hl.1
  | 1, hl => exact covers_sound c1 hl (Nat.zero_le _)
  | 2, hl => exact covers_sound c2 hl (Nat.zero_le _)
  | 3, hl => exact covers_sound c3 hl (Nat.zero_le _)
  | 4, hl => exact covers_sound c4 hl (Nat.zero_le _)
  | 5, hl => exact covers_sound c5 hl (Nat.zero_le _)
  | 6, hl => exact covers_sound c6 hl (Nat.zero_le _)
  | _ + 7, hl => exact absurd hl (by simp [F7.legal])


/-- The family `pureA`. -/
def fampureA (X : F7) : Prop :=
  X.e = 0 ∧ X.f = 0 ∧ X.k = 0 ∧ (X.b + X.c) + 1 = X.a ∧ X.d = min X.b X.c

instance (X : F7) : Decidable (fampureA X) := by unfold fampureA; infer_instance

/-- The family `pureB`. -/
def fampureB (X : F7) : Prop :=
